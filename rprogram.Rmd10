```{r}

n <- 5

# Upper half
for (i in 1:n) {
  cat(strrep(" ", n - i))
  cat(strrep("* ", i))
  cat("\n")
}

# Lower half
for (i in (n - 1):1) {
  cat(strrep(" ", n - i))
  cat(strrep("* ", i))
  cat("\n")
}
```
