```{r}
library(ggplot2)

ggplot(data = mtcars, aes(x = mpg)) +
  geom_histogram() +
  labs(
    title = "Distribution of Mileage",
    x = "Miles per Gallon",
    y = "Count"
  )
```
```{r}
ggplot(students, aes(x = FinalExamScore)) +
  geom_histogram(binwidth = 5, fill = "steelblue", color = "white") +
  labs(
    title = "Distribution of Final Exam Scores",
    x = "Final Exam Score",
    y = "Number of Students"
  )
```
```{r}
ggplot(students, aes(x = Result, fill = Result)) +
  geom_bar() +
  labs(
    title = "Number of Students: Pass vs Fail",
    x = "Result",
    y = "Number of Students"
  )
```
```{r}
ggplot(students, aes(x = PartTimeJob, y = FinalExamScore, fill = PartTimeJob)) +
  geom_boxplot() +
  labs(
    title = "Final Exam Score by Part-Time Job Status",
    x = "Has a Part-Time Job?",
    y = "Final Exam Score"
  )
```
```{r}
ggplot(students, aes(x = StudyHoursPerWeek, y = FinalExamScore)) +
  geom_point(color = "darkorange", alpha = 0.7) +
  geom_smooth(method = "lm", se = FALSE, color = "black") +
  labs(
    title = "Study Hours vs Final Exam Score",
    x = "Study Hours per Week",
    y = "Final Exam Score"
  )
```
```{r}
ggsave("study_hours_vs_score.png", width = 7, height = 5, dpi = 300)
```
```{r}
library(tidyverse)

# 2. Import data
students <- read_csv("student_performance.csv")

# 3. Explore data
str(students)
summary(students)
colSums(is.na(students))

# 4. Basic analysis
mean(students$FinalExamScore)

students %>%
  group_by(Gender) %>%
  summarise(AvgScore = mean(FinalExamScore))

cor(students$StudyHoursPerWeek, students$FinalExamScore)

# 5. Visualizations

ggplot(students, aes(x = FinalExamScore)) +
  geom_histogram(binwidth = 5, fill = "steelblue", color = "white")

ggplot(students, aes(x = Result, fill = Result)) +
  geom_bar()

ggplot(students, aes(x = PartTimeJob, y = FinalExamScore, fill = PartTimeJob)) +
  geom_boxplot()

ggplot(students, aes(x = StudyHoursPerWeek, y = FinalExamScore)) +
  geom_point() +
  geom_smooth(method = "lm", se = FALSE)
```
